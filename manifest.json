{
  "manifest_version": 3,
  "name": "tiny reader",
  "version": "1.0.0",
  "description": "tiny reader reads selected text, pages, pasted text, URLs, PDFs and ePubs aloud with a local voice model or your own TTS endpoint. No account.",
  "author": "tiny reader contributors",
  "browser_specific_settings": {
    "gecko": {
      "id": "tiny-reader@myfirefox.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "menus",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "logic/resample.js",
      "logic/chunks.js",
      "logic/remote.js",
      "logic/model-store.js",
      "logic/prefs.js",
      "background/engine-host.js",
      "background/player.js",
      "background/background.js"
    ]
  },
  "action": {
    "default_title": "tiny reader",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "toggle-read": {
      "suggested_key": {
        "default": "Ctrl+Alt+R"
      },
      "description": "Read the selection (or the page) aloud / pause"
    }
  },
  "homepage_url": "https://github.com/aljazceru/tiny-reader"
}
